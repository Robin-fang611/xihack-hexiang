    {
      "concept": "分类、角色、时间分开",
      "source_id": "P01",
      "paraphrase": "家族是分类；前中后调是持续性参照，边界相对；本项目主调/支撑/点缀是自拟构图角色。"
    },
    {
      "concept": "模块化调香体验",
      "source_id": "P02",
      "paraphrase": "该产品使用专门设计为可相互混合的完整香水模块；可借体验结构，不扩为任意香材兼容保证。"
    },
    {
      "concept": "现代材料也有燃香应用",
      "source_id": "P08",
      "paraphrase": "厂家提供Agarbatti用途示例，可研究应用条件和对照；不复制配方或将其替换为传统原料。"
    },
    {
      "concept": "真实混合非简单加法",
      "source_id": "P09",
      "paraphrase": "研究记录气味混合中的非线性与遮蔽；其食品条件不能变成本项目固定配伍公式。"
    }
  ],
